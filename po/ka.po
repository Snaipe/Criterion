#: src/log/normal.c:46
#, c-format
msgid "Criterion %s\n"
msgstr "Criterion %s\n"

#: src/log/normal.c:47
#, c-format
msgid "  %s\n"
msgstr "  %s\n"

#: src/log/normal.c:50 src/log/normal.c:51
#, c-format
msgid "%1$s::%2$s\n"
msgstr "%1$s::%2$s\n"

#: src/log/normal.c:52
#, c-format
msgid "%1$s::%2$s: (%3$3.2fs)\n"
msgstr "%1$s::%2$s: (%3$3.2fs)\n"

#: src/log/normal.c:53
#, c-format
msgid "%1$s::%2$s: Test was skipped\n"
msgstr "%1$s::%2$s: შემოწმება გამოტოვებულია\n"

#: src/log/normal.c:54
#, c-format
msgid "%1$s::%2$s: Test is disabled\n"
msgstr "%1$s::%2$s: შემოწმება გათიშულია\n"

#: src/log/normal.c:55
#, c-format
msgid "%1$s%2$s%3$s:%4$s%5$d%6$s: %7$s\n"
msgstr "%1$s%2$s%3$s:%4$s%5$d%6$s: %7$s\n"

#: src/log/normal.c:56
#, c-format
msgid "  %1$s: %2$s\n"
msgstr "  %1$s: %2$s\n"

#: src/log/normal.c:57
#, c-format
msgid "    %1$s: %2$s[-%3$s-]%4$s%5$s{+%6$s+}%7$s\n"
msgstr "    %1$s: %2$s[-%3$s-]%4$s%5$s{+%6$s+}%7$s\n"

#: src/log/normal.c:58
#, c-format
msgid "    %1$s: %2$s%3$s%4$s\n"
msgstr "    %1$s: %2$s%3$s%4$s\n"

#: src/log/normal.c:59
#, c-format
msgid "  Theory %1$s::%2$s failed with the following parameters: (%3$s)\n"
msgstr "  თეორია %1$s::%2$s ჩავარდა შემდეგი პარამეტრებით: (%3$s)\n"

#: src/log/normal.c:60
#, c-format
msgid "%1$s::%2$s: Timed out. (%3$3.2fs)\n"
msgstr "%1$s::%2$s: მოლოდინის ვადა ამოიწურა. (%3$3.2fs)\n"

#: src/log/normal.c:61
#, c-format
msgid "%1$s%2$s%3$s:%4$s%5$u%6$s: Unexpected signal caught below this line!\n"
msgstr ""
"%1$s%2$s%3$s:%4$s%5$u%6$s: ამ ხაზის ქვემოთ ჩაჭერილია მოულოდნელი სიგნალი!\n"

#: src/log/normal.c:62
#, c-format
msgid "%1$s::%2$s: CRASH!\n"
msgstr "%1$s::%2$s: ავარია!\n"

#: src/log/normal.c:63
#, c-format
msgid "%1$s::%2$s: %3$s\n"
msgstr "%1$s::%2$s: %3$s\n"

#: src/log/normal.c:64
#, c-format
msgid ""
"%1$sWarning! The test `%2$s::%3$s` crashed during its setup or teardown."
"%4$s\n"
msgstr ""
"%1$sგაფრთხილება! შემოწმება `%2$s::%3$s` ავარიულად დასრულდა მისი მორგებისას, "
"ან დაშლისას.%4$s\n"

#: src/log/normal.c:65
#, c-format
msgid ""
"%1$sWarning! The test `%2$s::%3$s` exited during its setup or teardown.%4$s\n"
msgstr ""
"%1$sგაფრთხილება! შემოწმება `%2$s::%3$s` დასრულდა მისი მორგებისას, ან "
"დაშლისას.%4$s\n"

#: src/log/normal.c:66
#, c-format
msgid "Running %1$s%2$lu%3$s test from %4$s%5$s%6$s:\n"
msgid_plural "Running %1$s%2$lu%3$s tests from %4$s%5$s%6$s:\n"
msgstr[0] "გაშვებულია %1$s%2$lu%3$s შემოწმება %4$s%5$s%6$s-დან:\n"
msgstr[1] "გაშვებულია %1$s%2$lu%3$s შემოწმება %4$s%5$s%6$s-დან:\n"

#: src/log/normal.c:68
#, c-format
msgid ""
"%1$sSynthesis: Tested: %2$s%3$lu%4$s | Passing: %5$s%6$lu%7$s | Failing: "
"%8$s%9$lu%10$s | Crashing: %11$s%12$lu%13$s %14$s"
msgstr ""
"%1$sსინთეზი: შემოწმებულია: %2$s%3$lu%4$s | გაიარა: %5$s%6$lu%7$s | ჩავარდა: "
"%8$s%9$lu%10$s | ავარია: %11$s%12$lu%13$s %14$s"

#: src/log/normal.c:73
#, c-format
msgid "%1$s| Skipped: %2$s%3$lu%4$s "
msgstr "%1$s| გამოტოვებულია: %2$s%3$lu%4$s "

#: src/log/normal.c:74
#, c-format
msgid "%2$*1$s%3$s%4$s%5$s\n"
msgstr "%2$*1$s%3$s%4$s%5$s\n"

#: src/log/normal.c:200
msgid "Assertion Failed"
msgstr "მტკიცება ჩავარდა"

#: src/string/i18n.c:15
msgid "The conditions for this assertion were not met."
msgstr "მტკიცების პირობები დაკმაყოფილებული არაა."

#: src/string/i18n.c:16
#, c-format
msgid "The expression %s is false."
msgstr "გამოსახულება %s ცრუა."

#: src/string/i18n.c:17
#, c-format
msgid "%s is null."
msgstr "%s ნულოვანია."

#: src/string/i18n.c:18
#, c-format
msgid "%s is not null."
msgstr "%s ნულოვანი არაა."

#: src/string/i18n.c:19
#, c-format
msgid "%s is empty."
msgstr "%s ცარიელია."

#: src/string/i18n.c:20
#, c-format
msgid "The statement `%s` did not throw any exception."
msgstr "პროცედურას `%s` გამონაკლისები არ გამოუყრია."

#: src/string/i18n.c:21
#, c-format
msgid "The statement `%s` threw some exception."
msgstr "გამოსახულებამ `%s` რამდენიმე გამონაკლისი ამოაგდო ."

#: src/string/i18n.c:24
#, c-format
msgid ""
"The expression (as strings) %1$s is false: actual=`%2$s` expected=`%3$s`."
msgstr ""
"გამოსახულება (სტრიქონების სახით) %1$s ცრუა: მიღებული=`%2$s` მოსალოდნელი "
"იყო=`%3$s`."

#: src/string/i18n.c:25
#, c-format
msgid "%1$s (`%2$s`) is not empty."
msgstr "%1$s (`%2$s`) ცარიელი არაა."

#: src/string/i18n.c:26
#, c-format
msgid "The file contents of %1$s does not match the string \"%2$s\"."
msgstr "ფაილის %1$s შემცველობა არ ემთხვევა სტრიქონს \"%2$s\"."

#: src/string/i18n.c:27
#, c-format
msgid "The file contents of %1$s does not match the contents of %2$s."
msgstr "ფაილის %1$s შემცველობა არ ემთხვევა %2$s-ის შემცველობას."

#: src/string/i18n.c:28
#, c-format
msgid "The statement `%1$s` did throw an instance of the `%2$s` exception."
msgstr "პროცედურამ `%1$s` ამოაგდო `%2$s`-ის გამონაკლისის მაგალითი."

#: src/string/i18n.c:29
#, c-format
msgid "The statement `%1$s` did not throw an instance of the `%2$s` exception."
msgstr "პროცედურამ `%1$s` არ ამოაგდო `%2$s`-ის გამონაკლისის მაგალითი."

#: src/core/runner.c:71
#, c-format
msgid ""
"%1$sWarning! Criterion has detected that it is running under valgrind, but "
"the number of jobs have been explicitely set. Reports might appear confusing!"
"%2$s\n"
msgstr ""
"%1$sგაფრთხილება! Criterion-მა დაადგინა, რომ ის valgrind-ითაა გაშვებული, "
"მაგრამ დავალებების რაოდენობა აშკარადაა მითითებული. ანგარიშები, შეიძლება, "
"დამაბნევლად მოგეჩვენოთ!%2$s\n"

#: src/io/output.c:38
#, c-format
msgid "Could not open the file @ `%1$s` for %2$s reporting: %3$s.\n"
msgstr "ვერ გავხსენი ფაილი @ `%1$s` %2$s-ის ანგარიშისთვის: %3$s.\n"

#: src/io/output.c:39
#, c-format
msgid "Writing %1$s report in `%2$s`.\n"
msgstr "%1$s-ის ანგარიშის ჩაწერა ფაილში `%2$s`.\n"
